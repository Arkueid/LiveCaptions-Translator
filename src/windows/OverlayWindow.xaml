<Window
    x:Class="LiveCaptionsTranslator.OverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Overlay Window"
    Width="650"
    Height="135"
    MinWidth="650"
    MinHeight="135"
    AllowsTransparency="True"
    Background="Transparent"
    MouseEnter="Window_MouseEnter"
    MouseLeave="Window_MouseLeave"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStyle="None"
    SizeToContent="Height"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="TransparentThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!--
            Compact tool buttons for the overlay. BasedOn keeps the WPF-UI template (hover and
            pressed states); without it the buttons fall back to plain WPF chrome, which is the
            light-gray squares the old bar showed.
        -->
        <Style
            x:Key="OverlayToolButton"
            BasedOn="{StaticResource {x:Type ui:Button}}"
            TargetType="{x:Type ui:Button}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Foreground" Value="#EBFFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="OverlayToolSeparator" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="14" />
            <Setter Property="Fill" Value="#26FFFFFF" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border
            x:Name="BorderBackground"
            Margin="5"
            Background="#80000000"
            CornerRadius="8"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <Grid>
                <ui:Card
                    x:Name="CaptionCard"
                    Margin="6,4,6,4"
                    Padding="14,10"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0">
                    <!--
                        One block per sentence pair, created in code. A blank text line between pairs
                        always costs a full line height (a line box is never shorter than `LineHeight`,
                        so a small-font spacer run did not help), which left far too much air between
                        groups. As separate blocks the gap is an exact margin.
                    -->
                    <StackPanel x:Name="CaptionStack" />
                </ui:Card>

                <!--
                    The tools live on their own translucent pill and are only faded in while the
                    pointer is on the overlay, so they never sit on top of the captions. The pause
                    toggle is first: it is the one control that changes what is being said on screen
                    (translation on/off), so it gets a real shape of its own — bars while running,
                    a triangle while paused — instead of a filled/unfilled variant of one glyph.
                -->
                <Border
                    x:Name="ControlPanel"
                    Margin="0,0,8,7"
                    Padding="4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#C2101010"
                    BorderBrush="#28FFFFFF"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            x:Name="PauseButton"
                            Click="PauseButton_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Pause Translation">
                            <ui:SymbolIcon x:Name="PauseIcon" FontSize="15" Symbol="Pause20" />
                        </ui:Button>
                        <Rectangle Style="{StaticResource OverlayToolSeparator}" />

                        <ui:Button
                            x:Name="FontSizeDecrease"
                            Click="FontDecrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Size Decrease">
                            <ui:SymbolIcon FontSize="15" Symbol="FontDecrease20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="FontSizeIncrease"
                            Click="FontIncrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Size Increase">
                            <ui:SymbolIcon FontSize="15" Symbol="FontIncrease20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="FontStrokeDecrease"
                            Click="FontStrokeDecrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Stroke Decrease">
                            <ui:SymbolIcon FontSize="15" Symbol="InkStrokeArrowDown20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="FontStrokeIncrease"
                            Click="FontStrokeIncrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Stroke Increase">
                            <ui:SymbolIcon FontSize="15" Symbol="InkStroke20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="FontBold"
                            Click="FontBold_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Bold">
                            <ui:SymbolIcon FontSize="15" Symbol="TextBold16" />
                        </ui:Button>
                        <ui:Button
                            x:Name="FontColorCycle"
                            Click="FontColorCycle_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Font Color">
                            <ui:SymbolIcon FontSize="15" Symbol="Color16" />
                        </ui:Button>
                        <Rectangle Style="{StaticResource OverlayToolSeparator}" />

                        <ui:Button
                            x:Name="OpacityDecrease"
                            Click="BackgroundOpacityDecrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Background Opacity Decrease">
                            <ui:SymbolIcon FontSize="15" Symbol="Subtract20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="OpacityIncrease"
                            Click="BackgroundOpacityIncrease_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Background Opacity Increase">
                            <ui:SymbolIcon FontSize="15" Symbol="Add20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="BackgroundColorCycle"
                            Click="BackgroundColorCycle_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Background Color">
                            <ui:SymbolIcon FontSize="15" Symbol="ColorBackground20" />
                        </ui:Button>
                        <Rectangle Style="{StaticResource OverlayToolSeparator}" />

                        <ui:Button
                            x:Name="OnlyModeButton"
                            Click="OnlyModeButton_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Show only subtitles or translations">
                            <ui:SymbolIcon x:Name="OnlyModeIcon" FontSize="15" Symbol="PanelBottom20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="SwitchModeButton"
                            Click="SwitchModeButton_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Switch the order of subtitles and translations">
                            <ui:SymbolIcon FontSize="15" Symbol="ArrowSwap20" />
                        </ui:Button>
                        <ui:Button
                            x:Name="ClickThrough"
                            Click="ClickThrough_Click"
                            Style="{StaticResource OverlayToolButton}"
                            ToolTip="Click Through (Ctrl+Alt+T to undo)">
                            <ui:SymbolIcon x:Name="ClickThroughIcon" FontSize="15" Symbol="LockClosed20" />
                        </ui:Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Thumb
            x:Name="TopThumb"
            Height="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Cursor="SizeNS"
            DragDelta="TopThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="BottomThumb"
            Height="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Cursor="SizeNS"
            DragDelta="BottomThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="LeftThumb"
            Width="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Stretch"
            Cursor="SizeWE"
            DragDelta="LeftThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="RightThumb"
            Width="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Stretch"
            Cursor="SizeWE"
            DragDelta="RightThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="TopLeftThumb"
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Cursor="SizeNWSE"
            DragDelta="TopLeftThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="TopRightThumb"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Cursor="SizeNESW"
            DragDelta="TopRightThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="BottomLeftThumb"
            Width="10"
            Height="10"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Cursor="SizeNESW"
            DragDelta="BottomLeftThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
        <Thumb
            x:Name="BottomRightThumb"
            Width="10"
            Height="10"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Cursor="SizeNWSE"
            DragDelta="BottomRightThumb_OnDragDelta"
            Style="{StaticResource TransparentThumbStyle}" />
    </Grid>
</Window>
