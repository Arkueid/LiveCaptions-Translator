<Page
    x:Class="LiveCaptionsTranslator.SettingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="SettingPage"
    JournalEntry.KeepAlive="False"
    mc:Ignorable="d">

    <ScrollViewer
        HorizontalContentAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalContentAlignment="Top"
        VerticalScrollBarVisibility="Auto">
        <!--
            Four equal columns, three rows, every control the same width. The old layout stacked five
            unrelated settings in one column while the other four held two each, which read as one
            tall strip next to a lot of empty space.
        -->
        <UniformGrid
            x:Name="SettingsGrid"
            Margin="10,8,10,8"
            VerticalAlignment="Top"
            Columns="4"
            Rows="3">
            <!-- Column 1: the translation pipeline -->
            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="LiveCaptions" />
                    <ui:Flyout x:Name="LiveCaptionsInfoFlyout">
                        <TextBlock Width="300" TextWrapping="Wrap">
                            <Run Text="After Windows 11 version 24H2, you can only change the" />
                            <Run FontWeight="DemiBold" TextDecorations="Underline" Text="Source Language" />
                            <Run Text="in LiveCaptions." />
                            <Run FontWeight="Bold" Text="&#x0A;&#x0A;Note:" />
                            <Run Text="Please click" />
                            <Run FontWeight="Bold" Text="&quot;Hide&quot;" />
                            <Run Text="to hide LiveCaptions instead of closing it directly." />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="LiveCaptionsInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="LiveCaptionsInfo_MouseEnter"
                        MouseLeave="LiveCaptionsInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ui:Button
                    x:Name="LiveCaptionsButton"
                    Width="150"
                    Height="28"
                    Padding="11,3,11,3"
                    HorizontalAlignment="Left"
                    Click="LiveCaptionsButton_click">
                    <TextBlock x:Name="ButtonText" Text="Show" />
                </ui:Button>
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="API Interval" />
                    <ui:Flyout x:Name="FrequencyInfoFlyout">
                        <TextBlock Width="320" TextWrapping="Wrap">
                            <Run Text="Determines how often a sentence that is still being spoken is re-translated." />
                            <Run Text="&#x0A;The smaller it is, the more frequent the API calls, and the more the subtitle may shift under your eyes." />
                            <Run Text="&#x0A;Finished sentences are always translated immediately." />
                            <Run Text="&#x0A;&#x0A;0 = refresh a growing sentence every 0.5 s, 10 = every 3 s." />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="FrequencyInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="FrequencyInfo_MouseEnter"
                        MouseLeave="FrequencyInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <Slider
                    Width="150"
                    Height="28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutoToolTipPlacement="TopLeft"
                    AutoToolTipPrecision="0"
                    Maximum="10"
                    Value="{Binding MaxSyncInterval, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock
                    Margin="2.5,0,0,3"
                    Text="Subtitle Font"
                    ToolTip="Font of the translation line in the overlay window. The first installed family in the list wins, so the choice still works on machines that lack it." />
                <ComboBox
                    x:Name="SubtitleFontBox"
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="SubtitleFontBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="Contexts" />
                    <ui:Flyout x:Name="CaptionLogMaxInfoFlyout">
                        <TextBlock Width="300" TextWrapping="Wrap">
                            <Run FontWeight="Bold" Text="Contexts:" />
                            <Run Text="Determines the number of context sentences when" />
                            <Run FontWeight="Bold" Text="Context Aware" />
                            <Run Text="is enabled." />
                            <Run FontWeight="Bold" Text="&#x0A;Overlay Sentences:" />
                            <Run Text="Total number of sentences displayed in the Overlay Window, including the sentence currently being spoken." />
                            <Run FontWeight="Bold" Text="&#x0A;&#x0A;Note:" />
                            <Run Text="Contexts must be" />
                            <Run FontWeight="Bold" Text="greater than or equal" />
                            <Run Text="Display Sentences. If not met, the program will automatically adjust them." />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="CaptionLogMaxInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="CaptionLogMaxInfo_MouseEnter"
                        MouseLeave="CaptionLogMaxInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ui:NumberBox
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    AcceptsExpression="False"
                    ClearButtonEnabled="False"
                    LargeChange="1"
                    Maximum="10"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding NumContexts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ValueChanged="Contexts_ValueChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="Translate API" />
                    <ui:Flyout x:Name="TranslateAPIInfoFlyout">
                        <TextBlock
                            Width="300"
                            Text="Except for Google and Google2, all other APIs require configuring before they can be used."
                            TextWrapping="Wrap" />
                    </ui:Flyout>
                    <Button
                        x:Name="TranslateAPIInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="TranslateAPIInfo_MouseEnter"
                        MouseLeave="TranslateAPIInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ComboBox
                    x:Name="TranslateAPIBox"
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    SelectedItem="{Binding ApiName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="TranslateAPIBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock Margin="2.5,0,0,3" Text="API Setting" />
                <ui:Button
                    x:Name="APISettingButton"
                    Width="150"
                    Height="28"
                    Padding="11,3,11,3"
                    HorizontalAlignment="Left"
                    Click="APISettingButton_click">
                    <TextBlock Text="Open" />
                </ui:Button>
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock
                    Margin="2.5,0,0,3"
                    Text="Source Font"
                    ToolTip="Font of the recognised (original) line. Pick a Japanese font when the audio is Japanese: Chinese fonts render kana and shared kanji with Chinese glyph shapes." />
                <ComboBox
                    x:Name="SourceFontBox"
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    DisplayMemberPath="DisplayName"
                    SelectionChanged="SourceFontBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock
                    Margin="2.5,0,0,3"
                    Text="Display Sentences"
                    ToolTip="Total number of sentences shown in the overlay window, including the one currently being spoken. 1 means only the current sentence." />
                <ui:NumberBox
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    AcceptsExpression="False"
                    ClearButtonEnabled="False"
                    LargeChange="1"
                    Maximum="6"
                    Minimum="1"
                    SmallChange="1"
                    SpinButtonPlacementMode="Inline"
                    Value="{Binding DisplaySentences, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ValueChanged="DisplaySentences_ValueChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="Target Language" />
                    <ui:Flyout x:Name="TargetLangInfoFlyout">
                        <TextBlock Width="350" TextWrapping="Wrap">
                            <Run FontWeight="DemiBold" TextDecorations="Underline" Text="&quot;There isn’t the target language I expect!&quot;" />
                            <Run Text="&#x0A;You can directly edit the content of this combobox to customize the language, and it is recommended to follow the" />
                            <Run FontWeight="Bold" Text="BCP 47 language tag." />
                            <Run FontWeight="Bold" Text="&#x0A;&#x0A;Note:" />
                            <Run Text="Some of APIs (such as DeepL) needs another way to define target language, see their official docs for more details." />
                            <Run Text="&#x0A;No need to consider this for included target languages, since we've built in tag mappings. But if your expected language isn't in the list, keep this in mind." />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="TargetLangInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="TargetLangInfo_MouseEnter"
                        MouseLeave="TargetLangInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ComboBox
                    x:Name="TargetLangBox"
                    Width="150"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    FontSize="13.3"
                    IsEditable="True"
                    LostFocus="TargetLangBox_LostFocus"
                    SelectionChanged="TargetLangBox_SelectionChanged" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Margin="2.5,0,0,3"
                        VerticalAlignment="Center"
                        Text="Context Aware" />
                    <ui:Flyout x:Name="ContextAwareInfoFlyout">
                        <TextBlock Width="300" TextWrapping="Wrap">
                            <Run Text="Translate in context." />
                            <Run Text="&#x0A;It can improve translation accuracy, but will consume more tokens." />
                        </TextBlock>
                    </ui:Flyout>
                    <Button
                        x:Name="ContextAwareInfo"
                        Width="15"
                        Height="15"
                        Margin="-5,-3,0,0"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        MouseEnter="ContextAwareInfo_MouseEnter"
                        MouseLeave="ContextAwareInfo_MouseLeave">
                        <ui:SymbolIcon Symbol="Info16" />
                    </Button>
                </StackPanel>
                <ui:ToggleSwitch
                    Width="110"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding ContextAware, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    OffContent="Off"
                    OnContent="On" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock
                    Margin="2.5,0,0,3"
                    Text="Line Spacing"
                    ToolTip="Line height as a multiple of the font size. 1.25 is tight, 1.5 is airy, 2.0 is very loose." />
                <Slider
                    Width="150"
                    Height="28"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    AutoToolTipPlacement="TopLeft"
                    AutoToolTipPrecision="2"
                    IsSnapToTickEnabled="True"
                    LargeChange="0.1"
                    Maximum="2"
                    Minimum="1.25"
                    SmallChange="0.05"
                    TickFrequency="0.05"
                    Value="{Binding OverlayWindow.LineSpacing, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <StackPanel Margin="4,5,4,5" VerticalAlignment="Center">
                <TextBlock Margin="2.5,0,0,3" Text="Show Latency" />
                <ui:ToggleSwitch
                    Width="110"
                    Height="28"
                    Padding="9,3,9,5"
                    HorizontalAlignment="Left"
                    IsChecked="{Binding MainWindow.LatencyShow, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    OffContent="Off"
                    OnContent="On" />
            </StackPanel>
        </UniformGrid>
    </ScrollViewer>
</Page>
